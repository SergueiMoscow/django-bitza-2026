SECRET_KEY=django_secret_key
; На проде — обязательно false. В bitza/settings.py DEBUG-страница отдаёт трейсбек с локальными
; переменными кому угодно, если оставить true.
DEBUG=false
; Фронт и бэк на одном домене (путь /api/* разведён в Caddyfile) — сейчас stage.b-site.ru,
; позже сюда же добавится bitza.b-site.ru при переключении DNS.
ALLOWED_HOSTS=stage.b-site.ru,bitza.b-site.ru
TRUSTED_ORIGINS=https://stage.b-site.ru,https://bitza.b-site.ru

DATABASE_ENGINE=postgresql
; === FOR POSTGRESQL ===
DATABASE_NAME=db_name
DATABASE_SCHEMA=public
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

; Норма потребления эл-ва, кВт·ч/мес — используется для цветовой индикации на графике потребления.
NORM_MONTH_KWT=80

; === Внешняя БД с показаниями Zigbee-счётчиков (bitza_ha), для sync_zigbee_readings ===
HA_DB_HOST=192.168.10.10
HA_DB_PORT=15432
HA_DB_NAME=bitza_ha
HA_DB_USER=ha_readonly_user
HA_DB_PASSWORD=change-me

; === S3 (Selectel) — приватное хранилище копий документов клиентов ===
S3_ENDPOINT=s3.ru-1.storage.selcloud.ru
S3_PORT=443
S3_REGION=ru-1
S3_BUCKET=bitza-documents
S3_ACCESS=change-me
S3_SECRET=change-me

; === Self-hosted Whisper (распознавание речи для голосовых команд) ===
WHISPER_URL=whisper.sushkovs.ru
WHISPER_USER=change-me
WHISPER_PASS=change-me

; === DeepSeek (разбор намерения голосовой команды — OpenAI-совместимый API) ===
DEEPSEEK_API_KEY=change-me

; === Claude API — сейчас не используется (голосовые команды переключены на DeepSeek),
; зависимость установлена на случай, если вернёмся или захотим сравнить.
ANTHROPIC_API_KEY=

; === Чеки/расходы (gRPC) — фича не подключена к фронтенду, значения можно оставить
; заглушками, чтобы Django стартовал (settings.py читает их без default).
BILLS_GRPC_SERVER_ADDRESS=127.0.0.1:50051
BILLS_SERVICE_TOKEN=unused

; === Deploy-вебхук (bitza/views.py::deploy, дёргается по push, см. deploy/) ===
DEPLOY_TOKEN=change-me
DEPLOY_ENDPOINT=deploy-webhook/
